# Render backend URL
EXPO_PUBLIC_API_URL=https://easyphonemarket.onrender.com

# Customer verification (Gmail address can receive the email OTP)
RESEND_API_KEY=SET_REAL_RESEND_API_KEY
# Resend sender MUST be from a verified domain. Gmail is the destination, not the sender.
RESEND_FROM_EMAIL=FULATAN COMMUNICATION <no-reply@your-verified-domain.com>
TERMII_API_KEY=SET_REAL_TERMII_API_KEY
TERMII_SENDER_ID=FULATAN
TERMII_CHANNEL=generic
