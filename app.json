{
  "expo": {
    "name": "FULATAN COMMUNICATION",
    "slug": "fulatan-communication",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fulatan.communication"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070809",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fulatan.communication"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fulatancommunication",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FULATAN COMMUNICATION to access your photos so you can upload phone images.",
          "cameraPermission": "Allow FULATAN COMMUNICATION to use your camera so you can take phone photos."
        }
      ]
    ],
    "description": "FULATAN Communication \u2014 Buy & Sell iPhone, Samsung and other quality phones."
  }
}
