{
  "expo": {
    "name": "EasyPhoneMarket",
    "slug": "easy-phone-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fulatan.easyphonemarket"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fulatan.easyphonemarket"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "easyphonemarket",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EasyPhoneMarket to access your photos so you can upload phone images.",
          "cameraPermission": "Allow EasyPhoneMarket to use your camera so you can take phone photos."
        }
      ]
    ]
  }
}
